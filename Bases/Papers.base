filters:
  and:
    - file.folder.startsWith("Research/Paper Notes")
    - category == "paper"
formulas:
  category: category
properties:
  file.name:
    displayName: Note
  citekey:
    displayName: Cite key
views:
  - type: table
    name: Paper notes
    order:
      - file.name
      - citekey
