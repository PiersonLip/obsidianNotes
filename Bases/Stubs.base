filters:
  and:
    - status == "stub"
properties:
  file.name:
    displayName: Note
  file.folder:
    displayName: Folder
  status:
    displayName: Status
views:
  - type: list
    name: Stubs
    order:
      - file.name
  - type: table
    name: Table
    order:
      - file.name
      - file.folder
      - status
