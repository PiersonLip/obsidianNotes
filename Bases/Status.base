filters:
  and:
    - or:
        - status == "stub"
        - status == "draft"
        - status == "wip"
        - status == "done"
properties:
  file.name:
    displayName: Note
  status:
    displayName: Status
  file.tags:
    displayName: Tags
views:
  - type: table
    name: By status
    order:
      - file.name
      - status
  - type: table
    name: Stub
    filters:
      and:
        - status == "stub"
    order:
      - file.name
      - status
  - type: table
    name: Draft
    filters:
      and:
        - status == "draft"
    order:
      - file.name
      - status
  - type: table
    name: WIP
    filters:
      and:
        - status == "wip"
    order:
      - file.name
      - status
  - type: table
    name: Done
    filters:
      and:
        - status == "done"
    order:
      - file.name
      - status
