# Caddy — serve Quartz static output at obsidianNotes.piersonl.com
# Copy to /etc/caddy/Caddyfile (or include from there).
#
# Prerequisites:
#   - DNS A/AAAA record for obsidianNotes.piersonl.com -> VPS IP
#   - REPO_DIR/public exists after first build (deploy/vps-build.sh)

obsidianNotes.piersonl.com {
	root * /var/www/obsidianNotes/public
	try_files {path} {path}.html {path}/ =404
	file_server
	encode gzip zstd

	handle_errors {
		rewrite * /{err.status_code}.html
		file_server
	}
}
